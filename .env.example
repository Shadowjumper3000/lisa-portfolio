# The whole stack runs in a single container, so DB_HOST, DB_PORT,
# MINIO_ENDPOINT, MINIO_USE_SSL and APP_ADDR are baked into the image — every
# hop is loopback and there is nothing to point at a sibling container.

# Database
# These must match the credentials the Postgres volume was initialised with.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portfolio

# Application
# Production refuses to start without this (no default fallback).
JWT_SECRET=changemeinproduction

# Object storage
# Production refuses to start without MINIO_ROOT_PASSWORD (min. 8 chars).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Admin seed
# Read by db/init/01-init.sh on a first-time initdb ONLY. Changing these later
# does not change an existing admin user — update the row instead.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Web
SERVER_NAME=_
VITE_CONTACT_EMAIL=hello@example.com
VITE_INSTAGRAM_URL=#
VITE_TWITTER_URL=#
